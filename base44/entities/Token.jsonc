{
  "name": "Token",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Token full name"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol, 2-6 uppercase letters"
    },
    "decimals": {
      "type": "number",
      "default": 18,
      "description": "ERC-20 decimals"
    },
    "total_supply": {
      "type": "string",
      "description": "Total supply as a string to preserve precision"
    },
    "contract_address": {
      "type": "string",
      "description": "Verified deployed contract address. Leave absent while status is defined."
    },
    "network": {
      "type": "string",
      "enum": [
        "mainnet",
        "sepolia"
      ],
      "default": "mainnet"
    },
    "wallet_id": {
      "type": "string",
      "description": "Reference wallet record id; does not prove deployment."
    },
    "deployer_address": {
      "type": "string",
      "description": "Reference wallet address; does not prove deployment."
    },
    "status": {
      "type": "string",
      "enum": [
        "defined",
        "deployed"
      ],
      "default": "defined",
      "description": "defined = off-chain parameters only; deployed = set only after verified on-chain deployment."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "symbol"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
