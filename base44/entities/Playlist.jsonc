{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Playlist name"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Playlist thumbnail"
    },
    "video_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of video IDs"
    },
    "videos_count": {
      "type": "number",
      "default": 0
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "unlisted"
      ],
      "default": "private"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "visibility": "public"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}