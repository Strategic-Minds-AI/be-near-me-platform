{
  "name": "Truth",
  "type": "object",
  "properties": {
    "initiator_email": {
      "type": "string",
      "description": "Email of the user who asked the truth and staked the Infinity Coin"
    },
    "responder_email": {
      "type": "string",
      "description": "Email of the user who must reveal the truth to win the stake"
    },
    "truth_prompt": {
      "type": "string",
      "description": "The truth question or prompt the responder must reveal"
    },
    "infinity_coin_stake": {
      "type": "number",
      "default": 0,
      "description": "Amount of Infinity Coin staked by the initiator"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revealed",
        "declined",
        "expired"
      ],
      "default": "pending"
    },
    "response_text": {
      "type": "string",
      "description": "The revealed truth from the responder"
    },
    "reward_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Infinity Coin reward was paid to the responder"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for the responder to accept and reveal"
    },
    "revealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "initiator_email",
    "responder_email",
    "truth_prompt"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.initiator_email": "{{user.email}}"
        },
        {
          "data.responder_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.initiator_email": "{{user.email}}"
        },
        {
          "data.responder_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.initiator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}