{
  "name": "AnalyticsDaily",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "video_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "watch_time_seconds": {
      "type": "number",
      "default": 0
    },
    "unique_viewers": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "dislikes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    },
    "subscribers_gained": {
      "type": "number",
      "default": 0
    },
    "subscribers_lost": {
      "type": "number",
      "default": 0
    },
    "revenue_cents": {
      "type": "number",
      "default": 0
    },
    "ad_impressions": {
      "type": "number",
      "default": 0
    },
    "cpm_cents": {
      "type": "number",
      "default": 0
    },
    "avg_view_duration": {
      "type": "number",
      "default": 0
    },
    "avg_view_percentage": {
      "type": "number",
      "default": 0
    },
    "traffic_sources": {
      "type": "object",
      "properties": {
        "search": {
          "type": "number"
        },
        "suggested": {
          "type": "number"
        },
        "browse": {
          "type": "number"
        },
        "external": {
          "type": "number"
        },
        "direct": {
          "type": "number"
        }
      }
    },
    "demographics": {
      "type": "object",
      "properties": {
        "countries": {
          "type": "object"
        },
        "devices": {
          "type": "object"
        },
        "age_groups": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "channel_id": "{{user.data.channel_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}