{
  "name": "Superchat",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "tier": {
      "type": "string",
      "enum": [
        "blue",
        "cyan",
        "green",
        "yellow",
        "orange",
        "magenta",
        "red"
      ],
      "default": "blue"
    },
    "stripe_payment_id": {
      "type": "string"
    },
    "display_duration": {
      "type": "number",
      "default": 60,
      "description": "How long to show in chat (seconds)"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "video_id",
    "amount_cents"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "channel_id": "{{user.data.channel_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "channel_id": "{{user.data.channel_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "channel_id": "{{user.data.channel_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}