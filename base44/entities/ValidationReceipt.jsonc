{
  "name": "ValidationReceipt",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "FactoryProject ID this receipt belongs to"
    },
    "registry_version": {
      "type": "string",
      "default": "2.0.0"
    },
    "build_spec_hash": {
      "type": "string",
      "description": "Hash of the BuildSpec for receipt correlation"
    },
    "hard_gates": {
      "type": "object",
      "description": "Pass/fail status of each hard gate (visual coherence, responsive, states, accessibility, content safety, motion, performance, reference lock, token purity, recipe integrity, platform authenticity, aesthetic restraint, visual regression)"
    },
    "scores": {
      "type": "object",
      "description": "Numeric scores per validation category"
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          }
        }
      }
    },
    "repair_round": {
      "type": "number",
      "default": 0,
      "description": "Which repair iteration (0-5)"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "default": "FAIL"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "result"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}