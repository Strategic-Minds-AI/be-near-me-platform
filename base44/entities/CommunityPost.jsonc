{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "channel_avatar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "poll",
        "image",
        "announcement"
      ],
      "default": "text"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "poll_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "votes": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "poll_total_votes": {
      "type": "number",
      "default": 0
    },
    "poll_voted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user emails who voted"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "members_only"
      ],
      "default": "public"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel_id",
    "type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "visibility": "public"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}