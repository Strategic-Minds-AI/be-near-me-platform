{
  "name": "WatchSession",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "watch_duration": {
      "type": "number",
      "default": 0,
      "description": "Seconds watched"
    },
    "video_duration": {
      "type": "number"
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "last_position": {
      "type": "number",
      "default": 0,
      "description": "Last playback position in seconds"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "view_counted": {
      "type": "boolean",
      "default": false,
      "description": "Whether this session counted as a view"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet",
        "tv",
        "unknown"
      ],
      "default": "unknown"
    },
    "quality_played": {
      "type": "string"
    },
    "ad_impressions": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "video_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}