{
  "name": "Reaction",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "video",
        "comment"
      ],
      "description": "What is being reacted to"
    },
    "target_id": {
      "type": "string",
      "description": "ID of video or comment"
    },
    "reaction": {
      "type": "string",
      "enum": [
        "like",
        "dislike"
      ]
    }
  },
  "required": [
    "target_type",
    "target_id",
    "reaction"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}