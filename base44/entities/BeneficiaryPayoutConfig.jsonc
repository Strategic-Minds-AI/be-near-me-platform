{
  "name": "BeneficiaryPayoutConfig",
  "type": "object",
  "properties": {
    "policy_id": {"type": "string", "default": "BNM-EA-REVENUE-001"},
    "beneficiary_pool_name": {"type": "string", "default": "Eva & Anastasia Beneficiary Pool"},
    "beneficiaries": {"type": "array", "items": {"type": "string"}},
    "eva_share_bps": {"type": "number"},
    "anastasia_share_bps": {"type": "number"},
    "destination_mode": {"type": "string", "enum": ["unconfigured", "single_legal_destination", "separate_legal_destinations"], "default": "unconfigured"},
    "destination_reference": {"type": "string"},
    "verified": {"type": "boolean", "default": false},
    "verification_note": {"type": "string"},
    "verified_at": {"type": "string", "format": "date-time"},
    "active": {"type": "boolean", "default": false}
  },
  "required": ["policy_id", "beneficiary_pool_name", "beneficiaries"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}