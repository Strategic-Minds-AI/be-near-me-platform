{
  "name": "RevenueAllocation",
  "type": "object",
  "properties": {
    "payment_receipt_id": {"type": "string"},
    "processor_event_id": {"type": "string"},
    "currency": {"type": "string", "default": "usd"},
    "platform_net_receipt_cents": {"type": "number", "default": 0},
    "platform_share_bps": {"type": "number", "default": 0},
    "platform_share_cents": {"type": "number", "default": 0},
    "beneficiary_pool_share_bps": {"type": "number", "default": 10000},
    "beneficiary_pool_cents": {"type": "number", "default": 0},
    "beneficiary_pool_name": {"type": "string", "default": "Eva & Anastasia Beneficiary Pool"},
    "settlement_state": {"type": "string", "enum": ["pending_destination", "ready", "transferred", "reversed", "blocked"], "default": "pending_destination"},
    "processor_transfer_id": {"type": "string"},
    "settled_at": {"type": "string", "format": "date-time"},
    "invariant_version": {"type": "string", "default": "BNM-EA-REVENUE-001"}
  },
  "required": ["payment_receipt_id", "platform_net_receipt_cents", "beneficiary_pool_cents"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}