{
  "name": "FactoryTemplate",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Unique template identifier"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "category": {
      "type": "string",
      "enum": [
        "frontend",
        "provisioning",
        "ai_consulting",
        "ai_system",
        "business_workflow",
        "infrastructure",
        "industry",
        "client_delivery",
        "page",
        "section",
        "document"
      ],
      "description": "Template registry category"
    },
    "subcategory": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "industry_compatibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform_compatibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object",
      "description": "Required input specifications"
    },
    "outputs": {
      "type": "object",
      "description": "Expected output specifications"
    },
    "validation_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "test",
        "validated",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "source": {
      "type": "string",
      "description": "Origin of this template (canonical, derived, operator-created)"
    },
    "definition": {
      "type": "object",
      "description": "Full template definition JSON"
    }
  },
  "required": [
    "template_id",
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}