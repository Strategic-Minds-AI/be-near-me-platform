{
  "name": "Payout",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "bank_transfer",
        "check"
      ],
      "default": "stripe"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "amount_cents"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}