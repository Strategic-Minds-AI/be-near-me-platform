{
  "name": "Comment",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "description": "Reference to video"
    },
    "text": {
      "type": "string",
      "description": "Comment content"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "dislikes": {
      "type": "number",
      "default": 0
    },
    "author_name": {
      "type": "string",
      "description": "Cached author display name"
    },
    "author_avatar": {
      "type": "string",
      "description": "Cached author avatar"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent comment ID for replies"
    },
    "replies_count": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_hearted": {
      "type": "boolean",
      "default": false,
      "description": "Creator hearted this comment"
    }
  },
  "required": [
    "video_id",
    "text"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}