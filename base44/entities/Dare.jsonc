{
  "name": "Dare",
  "type": "object",
  "properties": {
    "initiator_email": {
      "type": "string",
      "description": "Email of the user who created the dare and staked the Infinity Coin"
    },
    "challenger_email": {
      "type": "string",
      "description": "Email of the user who was dared and may accept"
    },
    "challenge_text": {
      "type": "string",
      "description": "The exact kindness dare description the challenger must complete"
    },
    "category": {
      "type": "string",
      "enum": [
        "kindness",
        "fitness",
        "creativity",
        "community",
        "environment",
        "learning",
        "bravery",
        "other"
      ],
      "default": "kindness",
      "description": "The kind of dare"
    },
    "infinity_coin_stake": {
      "type": "number",
      "default": 0,
      "description": "Amount of Infinity Coin the initiator stakes for completing the dare"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "in_progress",
        "submitted",
        "verified",
        "failed",
        "expired",
        "declined"
      ],
      "default": "pending"
    },
    "video_url": {
      "type": "string",
      "description": "Proof video uploaded by the challenger showing the dare completed"
    },
    "video_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the proof video matches the dare as initiated"
    },
    "verification_note": {
      "type": "string",
      "description": "Note from verification (AI or initiator) on whether the dare was completed exactly as initiated"
    },
    "reward_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Infinity Coin reward was paid to the challenger"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for the challenger to accept and complete the dare"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "initiator_email",
    "challenger_email",
    "challenge_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.initiator_email": "{{user.email}}"
        },
        {
          "data.challenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
