{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Syncs Google Analytics, Google Search Console, and GoDaddy domain data every 6 hours \u2014 stores snapshots so all historical data persists",
  "name": "Persistent Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "persistent_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_analytics": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analyticsSync"
          },
          "then": "sync_search_console",
          "x-base44": {
            "title": "Sync Google Analytics",
            "description": "Pull GA4 data for all properties"
          }
        }
      },
      {
        "sync_search_console": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "searchConsoleSync"
          },
          "then": "sync_godaddy",
          "x-base44": {
            "title": "Sync Search Console",
            "description": "Pull search performance for all sites"
          }
        }
      },
      {
        "sync_godaddy": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "godaddySync"
          },
          "then": "end",
          "x-base44": {
            "title": "Sync GoDaddy",
            "description": "Pull domain status & DNS records"
          }
        }
      }
    ]
  }
}