{
  "name": "Quality Gate",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quality_gate",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "validate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "qualityGate"
          },
          "then": "end",
          "x-base44": {
            "title": "Validate all media",
            "description": "Check & unpublish broken videos"
          }
        }
      }
    ]
  },
  "description": "Validates all public videos and thumbnails every 6 hours \u2014 automatically unpublishes any broken media so only 100% perfect content stays in the feed",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}