{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_video_scraper",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scrape": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoScraper"
          },
          "then": "end",
          "x-base44": {
            "title": "Scrape trending videos",
            "description": "Find and import top YouTube videos"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6,18 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Automatically finds and imports trending YouTube videos twice daily (6am & 6pm ET) across multiple categories, deduplicating against existing imports",
  "name": "Daily Video Scraper"
}