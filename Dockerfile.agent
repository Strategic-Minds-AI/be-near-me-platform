# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node ops/super-agent ./ops/super-agent
COPY --chown=node:node scripts/validate-container.mjs ./scripts/validate-container.mjs
COPY --chown=node:node scripts/validate-super-agent-runtime.mjs ./scripts/validate-super-agent-runtime.mjs
RUN mkdir -p /data/queue/pending /data/queue/working /data/queue/done /data/queue/blocked /data/queue/dead-letter /data/receipts /data/state \
 && chown -R node:node /data /workspace
USER node
ENV AGENT_DATA_DIR=/data \
    AGENT_WORKSPACE=/workspace \
    AGENT_HTTP_PORT=8787 \
    AGENT_POLL_MS=300000 \
    AGENT_LEASE_MS=420000 \
    AGENT_CONCURRENCY=1
EXPOSE 8787
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","ops/super-agent/supervisor.mjs"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["node","ops/super-agent/healthcheck.mjs"]
